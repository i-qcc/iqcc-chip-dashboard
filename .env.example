# Comma-separated list of quantum computer backends to display.
# When more than one is given, they are shown side-by-side on each screen.
BACKENDS=arbel

# How often (seconds) to re-download state/wiring from the IQCC cloud.
REFRESH_INTERVAL_SECONDS=600

# Metrics with a collection timestamp older than this many hours are hidden.
STALENESS_HOURS=5

# How long (seconds) each kiosk view is shown before advancing.
ROTATION_SECONDS=15

# IQCC cloud API tokens (JWT). Tokens are backend-specific: set one per backend
# as IQCC_API_TOKEN_<BACKEND>. IQCC_API_TOKEN is a fallback for any backend
# without its own. If neither is set, the client falls back to
# ~/.config/iqcc_cloud/config.toml (created via `iqcc-cloud setup`).
# IQCC_API_TOKEN_ARBEL=eyJ...
# IQCC_API_TOKEN=eyJ...

# Optional override for the IQCC cloud URL.
# IQCC_CLOUD_URL=https://cloud.i-qcc.com
