# Rename this file to "dashboard.env" and keep it next to run_dashboard.bat.

# Comma-separated backends shown side-by-side. Leave this UNSET (commented
# out) to use DEFAULT_BACKENDS from app/config.py in the repo - that way the
# launcher's auto-update (every UPDATE_CHECK_SECONDS) picks up changes pushed
# to GitHub's main branch with no per-machine edits. Only set it here if this
# specific kiosk should differ from the GitHub-side default.
# BACKENDS=arbel,gilboa

# One IQCC cloud API token (JWT) per backend: IQCC_API_TOKEN_<BACKEND>.
# These are secrets and must stay local - never commit them to GitHub.
IQCC_API_TOKEN_ARBEL=

REFRESH_INTERVAL_SECONDS=600

# Max seconds to wait for a single backend's cloud fetch before giving up and
# retrying on the next cycle (protects against a stuck/dead network call).
FETCH_TIMEOUT_SECONDS=90

STALENESS_HOURS=5
ROTATION_SECONDS=10.5

# How often (seconds) the launcher checks GitHub for a new dashboard version.
UPDATE_CHECK_SECONDS=3600

# The launcher also watches the running server every ~3 min (fixed) and
# force-restarts it if /healthz is unresponsive or /api/data hasn't refreshed
# in REFRESH_INTERVAL_SECONDS * 4 (min 900s) - the safety net for anything the
# FETCH_TIMEOUT_SECONDS fix above doesn't catch.
